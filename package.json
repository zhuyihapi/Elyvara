{
  "name": "elyvara",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "main": "dist/apps/desktop/src/main.js",
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "start": "electron .",
    "check": "npm run typecheck && npm run lint && npm run build",
    "smoke": "node scripts/smoke.mjs",
    "test": "npm run build && node --test dist/apps/signaling/src/server.test.js",
    "start:signaling": "node dist/apps/signaling/src/index.js"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "electron": "45.2.1",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
