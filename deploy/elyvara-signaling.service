[Unit]
Description=Elyvara room signaling
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/elyvara/current
EnvironmentFile=/etc/elyvara/signaling.env
ExecStart=/opt/elyvara/node/bin/node dist/apps/signaling/src/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
LoadCredential=tls-cert:/etc/elyvara/tls/fullchain.pem
LoadCredential=tls-key:/etc/elyvara/tls/privkey.pem
Environment=TLS_CERT=%d/tls-cert
Environment=TLS_KEY=%d/tls-key
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
